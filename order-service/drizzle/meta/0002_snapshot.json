        "orders_status_enum": {
          "name": "orders_status_enum",
          "value": "\"orders\".\"status\" IN ('PENDING_CREDIT', 'OPEN', 'ACCEPTED', 'PICKED_UP', 'DELIVERED', 'DISPUTED', 'COMPLETION_PENDING_CREDIT', 'RELEASE_PENDING_CREDIT', 'REJECTED', 'COMPLETED', 'CANCELLED', 'EXPIRED')"
        },
        "orders_reward_range": {
          "name": "orders_reward_range",
          "value": "\"orders\".\"reward\" BETWEEN 1 AND 5"
        },
        "orders_version_positive": {
          "name": "orders_version_positive",
          "value": "\"orders\".\"version\" >= 1"
        },
        "orders_items_array": {
          "name": "orders_items_array",
          "value": "jsonb_typeof(\"orders\".\"items\") = 'array' AND jsonb_array_length(\"orders\".\"items\") > 0"
        },
        "orders_supplier_object": {
          "name": "orders_supplier_object",
          "value": "jsonb_typeof(\"orders\".\"supplier_snapshot\") = 'object'"
        },
        "orders_delivery_zone_len": {
          "name": "orders_delivery_zone_len",
          "value": "char_length(\"orders\".\"delivery_zone\") BETWEEN 1 AND 200"
        },
        "orders_delivery_instructions_len": {
          "name": "orders_delivery_instructions_len",
          "value": "char_length(\"orders\".\"delivery_instructions\") BETWEEN 1 AND 1000"
        },
        "orders_courier_shape": {
          "name": "orders_courier_shape",
          "value": "\"orders\".\"status\" NOT IN ('ACCEPTED', 'PICKED_UP', 'DELIVERED', 'DISPUTED', 'COMPLETION_PENDING_CREDIT', 'COMPLETED') OR \"orders\".\"courier_id\" IS NOT NULL"
        },
        "orders_release_reason_shape": {
          "name": "orders_release_reason_shape",
          "value": "\"orders\".\"release_reason\" IS NULL OR \"orders\".\"release_reason\" IN ('CANCELLED', 'EXPIRED')"
        },
        "orders_rejection_shape": {
          "name": "orders_rejection_shape",
          "value": "(\"orders\".\"status\" = 'REJECTED') = (\"orders\".\"rejection_reason\" IS NOT NULL)"
        }
      },
