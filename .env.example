# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Create your `.env` from it:   ./scripts-init-env.sh
#
# `.env` is git-ignored — NEVER commit it.
# Every variable a service reads MUST appear here, so a teammate
# knows what exists (PL-NFR2.1.1). A secret has NO value here:
#
#   NAME=<generated>           the script makes a random value
#   NAME=<generated:ed25519>   the script makes a signing key
#   NAME=<from:...{OTHER}...>  the script builds it from others
#
# so no password, key or token is in source control, and no two
# machines share one. Run the script again after pulling: it adds
# what is new and never changes a value you already have.
#
# A missing required variable stops Compose, or the service at
# boot, with the variable named — nothing has a fallback.
# ─────────────────────────────────────────────────────────────

# ---- Shared by every service --------------------------------
# NODE_ENV   development | test | production
# LOG_LEVEL  fatal | error | warn | info | debug | trace | silent
NODE_ENV=development
LOG_LEVEL=info

# Browser origins allowed to call the services, comma-separated.
# Never set this to `*` — these endpoints carry credentials.
CORS_ORIGINS=http://localhost:3000

# ---- Host ports ---------------------------------------------
# Change any of these if something already holds the port. The
# ports INSIDE the containers never change. WEB_APP_PORT is the
# edge's: the one origin the browser opens, on every interface
# (ADR 0010). The others are published on 127.0.0.1 only, for the
# scripts; CORS_ORIGINS above must match the edge's origin.
WEB_APP_PORT=3000
USER_SERVICE_PORT=3001
SUPPLIER_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
ORDER_CREDIT_WAIT_TIMEOUT_MS=300000
ORDER_ACCEPTANCE_WINDOW_MS=3600000
ORDER_PICKUP_TIMEOUT_MS=1800000
ORDER_DELIVERY_PERIOD_MS=7200000
ORDER_AUTO_CONFIRM_MS=86400000
ORDER_LIFECYCLE_SWEEP_INTERVAL_MS=10000
ORDER_RECONCILE_INTERVAL_MS=60000
ORDER_RECONCILE_RETRY_MS=300000
# N1.4: `false` turns live errand updates off; every page then polls, as before.
ORDER_LIVE_UPDATES_ENABLED=true
CREDIT_SERVICE_PORT=3004
# Credits a new wallet is issued, 5 to 50. Unset: the service's
# default of 10 (credit-service README, "The initial allocation").
# Affects wallets created afterwards only.
# INITIAL_CREDIT_ALLOCATION=10

# Deliberately not 5432/5672: a locally installed Postgres or
# RabbitMQ usually holds those, and `docker compose up` would
# fail to bind.
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=15672

# Observability (PLT-04): Grafana's dashboard, and Prometheus behind it.
# Both listen on 127.0.0.1 only.
GRAFANA_PORT=3005
PROMETHEUS_PORT=9090

# ---- Postgres -----------------------------------------------
# One server hosting one database and one role per service; see
# postgres-init.sh. POSTGRES_* is the superuser that creates them;
# each service then connects as its own role, with its own password,
# and can open only its own database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generated>
USER_DB_PASSWORD=<generated>
SUPPLIER_DB_PASSWORD=<generated>
ORDER_DB_PASSWORD=<generated>
CREDIT_DB_PASSWORD=<generated>

# ---- RabbitMQ -----------------------------------------------
# RABBITMQ_USER is the operator: the management UI at
# http://localhost:15672, and the smoke and demo scripts. No service
# uses it. Each service has an account of its own (named after it),
# which may publish only its own events and read only its own queues;
# see rabbitmq-init.sh.
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=<generated>
USER_BROKER_PASSWORD=<generated>
SUPPLIER_BROKER_PASSWORD=<generated>
ORDER_BROKER_PASSWORD=<generated>
CREDIT_BROKER_PASSWORD=<generated>

# ---- Grafana (PLT-04) ---------------------------------------
# The dashboard is open to view without signing in; this is the
# admin's password, needed only to change things.
GRAFANA_ADMIN_PASSWORD=<generated>

# The bearer token Prometheus sends to every service's GET /metrics, at
# least 16 characters. Unset, /metrics is open in development and refused in
# production.
METRICS_TOKEN=<generated>

# ---- User Service (USR-01) ----------------------------------
# Registration is limited to these email domains, comma-separated.
ALLOWED_EMAIL_DOMAINS=u.nus.edu,nus.edu.sg

# What each calling service sends as `X-Service-Key` to reach another
# service's /internal/** endpoints: one key per caller, so a service
# cannot present itself as another.
SUPPLIER_INTERNAL_KEY=<generated>
ORDER_INTERNAL_KEY=<generated>
CREDIT_INTERNAL_KEY=<generated>

# The keys the User Service accepts: every caller's, comma-separated.
INTERNAL_SERVICE_KEYS=<from:{SUPPLIER_INTERNAL_KEY},{ORDER_INTERNAL_KEY},{CREDIT_INTERNAL_KEY}>

# Bootstrap administrators, created on first boot (comma-separated), with a
# shared bootstrap password: read it from your `.env`. An address that already
# has an account is skipped, never promoted. The password cannot sign in: each
# admin must replace it via POST /auth/password, and until they do, anyone who
# knows it can. Claim each account at once, and rotate the password whenever
# ADMIN_SEED_EMAILS changes.
ADMIN_SEED_EMAILS=admin@u.nus.edu
ADMIN_SEED_PASSWORD=<generated>

# Signs access tokens: base64 of an Ed25519 private key (PKCS#8 PEM).
# REQUIRED in production and by Compose, so a restart does not sign everyone
# out. Running the User Service on its own without it (`npm run dev:user` with
# no `.env`) makes a throwaway key at each boot.
JWT_PRIVATE_KEY=<generated:ed25519>

# Hours an emailed activation link stays valid (default 24, max 168).
# ACTIVATION_TOKEN_TTL_HOURS=24

# Controls on administrators (ADR 0008). All optional; the defaults are shown.
# How long a role change may wait for a second admin's approval (1-168 h).
# ROLE_REQUEST_TTL_HOURS=24
# How recently an admin must have re-entered their password (POST /auth/step-up)
# before a role change or suspending another admin (30-3600 s).
# STEP_UP_WINDOW_SECONDS=300
# Suspensions by one admin in an hour that raise an alert, and that are refused
# beyond the limit.
# ADMIN_SUSPENSIONS_ALERT_PER_HOUR=10
# ADMIN_SUSPENSIONS_LIMIT_PER_HOUR=20
# Accounts one admin opens in an hour that raise an alert.
# ADMIN_READS_ALERT_PER_HOUR=50
# Sign-ins per 15 minutes from one address and for one account, and sign-ups per
# hour from one address (US-NFR2). The defaults are the policy, kept in
# user-service/src/auth/rate-limiter.ts (a test checks these match). A stack off
# production may raise them, as the load test's does (compose.load.yaml); in
# production one above the policy stops the User Service starting.
# LOGIN_LIMIT_PER_IP=50
# LOGIN_LIMIT_PER_EMAIL=10
# REGISTER_LIMIT_PER_IP=20
# Credit Service: distinct wallets one admin reads in an hour that raise an alert.
# ADMIN_WALLET_READS_ALERT_PER_HOUR=50

# ---- Supplier Service (SUP-01) ------------------------------
# The Supplier Service verifies callers by asking the User Service who is
# behind a token (@foc/auth-client). It presents SUPPLIER_INTERNAL_KEY (above)
# as `X-Service-Key`.

# ---- Order and Credit Services (USR-07) ---------------------
# Same mechanism as the Supplier Service: each presents its own key
# (ORDER_INTERNAL_KEY, CREDIT_INTERNAL_KEY above) to the User Service.

# The keys Credit accepts on its read-only /internal/** recovery API: the
# Order Service's. Comma-separate any additional approved caller.
CREDIT_INBOUND_SERVICE_KEYS=<from:{ORDER_INTERNAL_KEY}>

# USER_SERVICE_URL and INTERNAL_SERVICE_KEY are injected per container by
# compose.yaml (http://user-service:4001, the User Service's internal port, and
# the key above for that service). The Supplier, Order and Credit Services all
# REQUIRE both: set them yourself when running one of them directly outside
# Compose (`npm run dev:*`). Against a User Service you also run by hand:
#   USER_SERVICE_URL=http://localhost:3001
#   INTERNAL_SERVICE_KEY=<the value of ORDER_INTERNAL_KEY>
# Against the one in Compose, start the stack with compose.dev.yaml, which
# publishes its internal port on 127.0.0.1, and use http://localhost:4001.

# ---- Outside Compose: the stack's data stores, from this machine ----
# Not read by Compose or by any service. They are the addresses of the
# Compose stack's Postgres and RabbitMQ as this machine reaches them
# (both listen on 127.0.0.1 only), for the real-database and real-broker
# test suites and for running one service by hand:
#
#   set -a; . ./.env; set +a
#   TEST_POSTGRES_URL=$HOST_POSTGRES_URL RABBITMQ_URL=$HOST_RABBITMQ_URL npm test
#   DATABASE_URL=$HOST_ORDER_DATABASE_URL npm run dev:order
#
# Built when `.env` is created. If you change a port or password above,
# delete these lines and run ./scripts-init-env.sh again.
HOST_POSTGRES_URL=<from:postgres://{POSTGRES_USER}:{POSTGRES_PASSWORD}@localhost:{POSTGRES_PORT}/postgres>
HOST_RABBITMQ_URL=<from:amqp://{RABBITMQ_USER}:{RABBITMQ_PASSWORD}@localhost:{RABBITMQ_PORT}>
HOST_USER_DATABASE_URL=<from:postgres://user_service:{USER_DB_PASSWORD}@localhost:{POSTGRES_PORT}/foc_user>
HOST_SUPPLIER_DATABASE_URL=<from:postgres://supplier_service:{SUPPLIER_DB_PASSWORD}@localhost:{POSTGRES_PORT}/foc_supplier>
HOST_ORDER_DATABASE_URL=<from:postgres://order_service:{ORDER_DB_PASSWORD}@localhost:{POSTGRES_PORT}/foc_order>
HOST_CREDIT_DATABASE_URL=<from:postgres://credit_service:{CREDIT_DB_PASSWORD}@localhost:{POSTGRES_PORT}/foc_credit>

# ---- Supplied by Compose, not set here ----------------------
# SERVICE_NAME, PORT, INTERNAL_PORT, DATABASE_URL and RABBITMQ_URL are
# injected per container by compose.yaml. Set them yourself only when
# running a service directly outside Compose:
#
#   SERVICE_NAME=user-service
#   PORT=3001
#
# DATABASE_URL is read by every service that owns persistence; Compose injects
# the service-specific database and role.
#
# INTERNAL_PORT is a second port that serves /internal/**; with it set, the
# public port hides those routes. Compose sets it and does not publish it.
# Unset (as in `npm run dev`), internal routes are on the public port.
#
# RABBITMQ_URL *is* read, by every service. It is optional: a
# service without it still boots and simply does not publish or
# consume, so `npm run dev:user` works with no broker running.
# Without it Supplier, Order and Credit get no identity-change
# events and rely on the 5 s auth cache window alone (USR-07).
# Compose always supplies it.

# ---- Added by later tickets ---------------------------------
# Add variables here in the ticket that introduces them, never
# before. A secret is written as NAME=<generated>, never with a value.
