# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and adjust:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Every variable a service reads MUST appear here with a safe
# placeholder, so a teammate knows what to set (PL-NFR2.1.1).
#
# A missing required variable stops the service at boot with the
# variable named — it will not start with an insecure default.
#
# The values below are LOCAL DEVELOPMENT ONLY. Nothing here is a
# real credential and nothing here may be reused off a laptop.
# ─────────────────────────────────────────────────────────────

# ---- Shared by every service --------------------------------
# NODE_ENV   development | test | production
# LOG_LEVEL  fatal | error | warn | info | debug | trace | silent
NODE_ENV=development
LOG_LEVEL=info

# Browser origins allowed to call the services, comma-separated.
# Never set this to `*` — these endpoints carry credentials.
CORS_ORIGINS=http://localhost:3000

# ---- Host ports ---------------------------------------------
# Change any of these if something already holds the port. The
# ports INSIDE the containers never change.
WEB_APP_PORT=3000
USER_SERVICE_PORT=3001
SUPPLIER_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
CREDIT_SERVICE_PORT=3004

# Deliberately not 5432/5672: a locally installed Postgres or
# RabbitMQ usually holds those, and `docker compose up` would
# fail to bind.
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Postgres -----------------------------------------------
# One server hosting one database and one role per service; see
# postgres-init.sql. These are the superuser credentials used to
# create them, not the per-service ones.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# ---- RabbitMQ -----------------------------------------------
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=foc_dev

# ---- Supplied by Compose, not set here ----------------------
# SERVICE_NAME, PORT, DATABASE_URL and RABBITMQ_URL are injected
# per container by compose.yaml. Set them yourself only when
# running a service directly outside Compose:
#
#   SERVICE_NAME=user-service
#   PORT=3001
#
# No service reads DATABASE_URL or RABBITMQ_URL yet — the
# connection is provisioned and passed in, ready for USR-01,
# SUP-01 and EVT-01 to consume.

# ---- Added by later tickets ---------------------------------
# USR-02 adds the JWT signing key. Add variables here in the
# ticket that introduces them, never before.
